---
interface Props {
	title?: string;
}

const { title = 'marimo notebooks' } = Astro.props;
---
<!doctype html>
<html lang="en-GB">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Interactive marimo notebooks running entirely in the browser."
		/>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;1,400&family=PT+Sans:ital,wght@0,400;0,700;1,400&family=Fira+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/*
	 * Theme tokens mirrored from marimo's light theme
	 * (exported bundle assets/index-*.css), so the Astro shell and the
	 * embedded notebooks share one visual language. If marimo updates its
	 * theme, re-export a notebook and compare against these values.
	 */
	:root {
		--background: #fff;
		--foreground: #0f172a;
		--muted: #f1f5f9;
		--muted-foreground: #64748b;
		--card: #fff;
		--card-foreground: #0f172a;
		--border: #e2e8f0;
		--input: #a3a3a3;
		--primary: #0880ea;
		--primary-foreground: #f8fafc;
		--secondary: #f1f5f9;
		--accent: #edf6ff;
		--accent-foreground: #0b68cb;
		--link: #0b68cb;
		--link-visited: #8e4ec6;
		--radius: 8px;
		--monospace-font: 'Fira Mono', ui-monospace, monospace;
		--text-font: 'PT Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI',
			Roboto, 'Helvetica Neue', Arial, sans-serif;
		--heading-font: 'Lora', Georgia, serif;
	}

	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	body {
		background-color: var(--background);
		color: var(--foreground);
		font-family: var(--text-font);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
	}

	h1,
	h2,
	h3 {
		font-family: var(--heading-font);
		font-weight: 500;
		line-height: 1.25;
		color: var(--foreground);
	}

	a {
		color: var(--link);
	}

	a:visited {
		color: var(--link-visited);
	}

	code,
	pre {
		font-family: var(--monospace-font);
	}

	::selection {
		background-color: var(--accent);
	}
</style>
