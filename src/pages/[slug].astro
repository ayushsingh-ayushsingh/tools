---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';

export function getStaticPaths() {
	const notebooksDir = path.join(process.cwd(), 'notebooks', 'src');
	let files: string[] = [];
	try {
		files = fs.readdirSync(notebooksDir);
	} catch {
		files = [];
	}

	return files
		.filter((file) => file.endsWith('.py') && !path.basename(file).startsWith('_'))
		.map((file) => {
			const slug = path.basename(file, '.py');
			const title = slug
				.split(/[-_]+/)
				.map((word) => word.charAt(0).toUpperCase() + word.slice(1))
				.join(' ');
			return { params: { slug }, props: { slug, title } };
		});
}

const { slug, title } = Astro.props;
// Link the index file directly: dev servers do not always resolve directory
// URLs to index.html, while every static host serves the file itself.
const bundleUrl = `/notebooks/${slug}/index.html`;
---

<Layout title={`${title} — marimo notebook`}>
	<main class="notebook-page">
		<nav class="notebook-nav" aria-label="Notebook navigation">
			<a href="/">&larr; All notebooks</a>
		</nav>
		<header class="notebook-header">
			<h1>{title}</h1>
			<p class="notebook-sub">
				<span class="badge">Runs in your browser · WebAssembly</span>
			</p>
			<p>
				Interactive marimo notebook running entirely in your browser. If it does not
				load below, <a href={bundleUrl}>open the standalone version</a>.
			</p>
		</header>
		<div class="notebook-frame-wrap">
			<iframe
				src={bundleUrl}
				title={`${title} notebook`}
				loading="lazy"
				allow="cross-origin-isolated; autoplay; clipboard-write"
			></iframe>
		</div>
	</main>
</Layout>

<script>
	// Marimo notifies on every run that completes while its tab is hidden, and
	// actively requests notification permission when undecided (upstream issue
	// marimo-team/marimo#3659, no opt-out setting as of marimo 0.24.2). The
	// embedded bundle is same-origin, so decline on behalf of undecided
	// visitors: no permission prompts, no repeat notifications. A permission
	// the visitor already granted or denied is always left untouched.
	const frame = document.querySelector('.notebook-frame-wrap iframe');
	const declineNotificationPrompts = () => {
		try {
			const embedded = frame?.contentWindow;
			const Notify = embedded?.Notification;
			if (!embedded || !Notify || Notify.permission !== 'default') {
				return;
			}
			Object.defineProperty(Notify, 'requestPermission', {
				configurable: true,
				value: () => Promise.resolve('denied'),
			});
		} catch {
			// Embedded page unreachable (e.g. served cross-origin): leave it alone.
		}
	};
	frame?.addEventListener('load', declineNotificationPrompts, { once: true });
</script>

<style>
	.notebook-page {
		margin: 0 auto;
		max-width: 72rem;
		padding: 1.5rem 1rem 2.5rem;
		color: var(--foreground);
	}
	.notebook-nav a {
		color: var(--link);
		text-decoration: none;
		font-size: 0.9rem;
	}
	.notebook-nav a:hover {
		text-decoration: underline;
	}
	.notebook-header h1 {
		margin: 0.75rem 0 0.5rem;
		font-size: 1.9rem;
	}
	.notebook-sub {
		margin: 0 0 0.5rem;
	}
	.badge {
		display: inline-block;
		padding: 0.2rem 0.65rem;
		font-size: 0.8rem;
		color: var(--accent-foreground);
		background-color: var(--accent);
		border-radius: calc(var(--radius) - 2px);
	}
	.notebook-header p {
		margin: 0 0 1rem;
		color: var(--muted-foreground);
	}
	.notebook-header p a {
		color: var(--link);
	}
	.notebook-frame-wrap {
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
		background: var(--card);
	}
	.notebook-frame-wrap iframe {
		display: block;
		width: 100%;
		height: calc(100vh - 240px);
		min-height: 640px;
		border: 0;
		background: var(--background);
	}
</style>
