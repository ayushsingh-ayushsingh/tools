---
import Layout from "../layouts/Layout.astro";
import LayerCard from "../components/LayerCard.astro";
import KumoButton from "../components/KumoButton.astro";
import { discoverNotebooks } from "../lib/notebooks";

const notebooks = discoverNotebooks();
---

<Layout
    title="Interactive notebooks"
    description="A catalogue of interactive notebooks. Each one runs entirely in your browser."
>
    <main class="mx-auto grid w-full max-w-5xl gap-6 p-4">
        <div class="grid max-w-5xl gap-1.5">
            <h1 class="m-0 text-xl">Interactive notebooks</h1>
            <p class="m-0 text-sm text-kumo-subtle">
                Each notebook runs entirely in your browser, no server required.
                Choose one to get started.
            </p>
        </div>
        {notebooks.length === 0 ? (
            <p class="m-0 text-sm text-kumo-subtle">
                No notebooks yet. Run{" "}
                <code class="rounded bg-kumo-tint px-1 py-px">
                    pnpm notebooks:export
                </code>{" "}
                and reload this page.
            </p>
        ) : (
            <ul class="m-0 grid list-none gap-4 p-0 sm:grid-cols-2 lg:grid-cols-3">
                {notebooks.map((notebook) => (
                    <li>
                        <LayerCard>
                            <div class="grid gap-1.5">
                                <h2 class="m-0 text-base">
                                    <a
                                        href={`/${notebook.slug}`}
                                        class="text-kumo-strong no-underline hover:text-kumo-link hover:underline"
                                    >
                                        {notebook.title}
                                    </a>
                                </h2>
                                <p class="m-0 flex flex-wrap items-center gap-2 pt-1.5">
                                    <KumoButton
                                        href={`/${notebook.slug}/index.html`}
                                    >
                                        Use
                                    </KumoButton>
                                    <KumoButton
                                        variant="outline"
                                        href={`/${notebook.slug}/edit/index.html`}
                                    >
                                        Edit
                                    </KumoButton>
                                </p>
                            </div>
                        </LayerCard>
                    </li>
                ))}
            </ul>
        )}
    </main>
</Layout>
